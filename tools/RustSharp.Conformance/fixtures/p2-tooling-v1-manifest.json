      "scenario": "Input fn main(){let x=1;x;} renders four-space indentation, LF and one final newline; AST remains equal."
    },
    {
      "id": "format-comments",
      "area": "formatter",
      "expected": "pass",
      "scenario": "Leading, inline and trailing // and /* comments retain exact spelling and relative token order."
    },
    {
      "id": "format-doc-comments",
      "area": "formatter",
      "expected": "pass",
      "scenario": "///, //!, /** and /*! documentation comments remain attached to the same module or item."
    },
    {
      "id": "format-nested-comments",
      "area": "formatter",
      "expected": "pass",
      "scenario": "Input fn f(){/* outer /* inner */ tail */let x=1;} retains the entire nested block comment."
    },
    {
      "id": "format-literals",
      "area": "formatter",
      "expected": "pass",
      "scenario": "Numeric suffixes, UTF-8/raw/byte/C strings and character literal tokens retain byte-for-byte spelling."
    },
    {
      "id": "format-crlf",
