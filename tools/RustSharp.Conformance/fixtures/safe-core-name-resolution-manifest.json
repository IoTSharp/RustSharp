    "maximumSourceLength": 65536,
    "maximumTokens": 16384,
    "maximumNodes": 8192,
    "maximumDiagnostics": 64,
    "maximumNestingDepth": 64,
    "maximumOperations": 100000
  },
  "resolutionLimits": {
    "maximumSymbols": 4096,
    "maximumScopes": 2048,
    "maximumPathSegments": 64,
